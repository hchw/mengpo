# Canonical runtime configuration. All keys use the MEMORY_ prefix and match
# deploy/dev/docker-compose.yml and docs/operations.md. Unprefixed legacy names
# (APP_ENV, HTTP_ADDR, DATABASE_URL, MQ_*, EMBEDDING_*, RERANKER_*, AUTH_*,
# MAX_REQUEST_BYTES, ALLOW_EXTERNAL_LLM_ANALYSIS) are still accepted during the
# migration window but new deployments must use the names below.
MEMORY_APP_ENV=development
MEMORY_HTTP_ADDR=:8080
MEMORY_HTTP_REQUEST_TIMEOUT=30s
MEMORY_DATABASE_URL=postgres://memory:memory@localhost:5432/memory?sslmode=disable
MEMORY_REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_MIGRATE_ON_START=true
MEMORY_AUTH_SESSION_TTL=12h
MEMORY_AUTH_COOKIE_SECURE=false
# Only the two supported memory dimensions are configured in code:
# user-global and session.
MEMORY_EMBEDDING_ENABLED=false
MEMORY_EMBEDDING_ARTIFACT=models/bge-small-zh-v1.5-Q8_0.gguf
MEMORY_EMBEDDING_BINARY=llama-embedding
# bge-small-zh-v1.5 uses CLS pooling and an instruction prefix on queries only.
MEMORY_EMBEDDING_POOLING=cls
MEMORY_EMBEDDING_QUERY_PREFIX="为这个句子生成表示以用于检索相关文章："
MEMORY_EMBEDDING_DOCUMENT_PREFIX=
# Local embedding and model providers are disabled until explicitly enabled.
MEMORY_LLM_ENABLED=false
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_API_KEY=
MEMORY_LLM_TIMEOUT=30s
MEMORY_LLM_MAX_ATTEMPTS=3
MEMORY_ANALYSIS_MAX_TOKENS=2048
MEMORY_MAINTENANCE_BATCH_SIZE=50
# Periodic scheduling component: internal (in-process) or none (disabled).
# Each tenant owns its own schedule; 24h is the default cadence.
MEMORY_SCHEDULER_ADAPTER=internal
MEMORY_SCHEDULE_DEFAULT_INTERVAL=24h
# Encrypts per-tenant provider secrets at rest. Inject from a secret store;
# never commit a real value. Leave empty to disable provider secret storage.
MEMORY_CONFIG_MASTER_KEY=
MEMORY_ALLOW_EXTERNAL_LLM_ANALYSIS=false
MEMORY_RERANKER_ENABLED=false
MEMORY_RERANKER_BASE_URL=
MEMORY_RERANKER_MODEL=
MEMORY_RERANKER_API_KEY=
# NATS Core is the default best-effort notification adapter. PostgreSQL remains
# the durable job source of truth. Set MEMORY_QUEUE_ADAPTER=none to use database
# polling only.
MEMORY_QUEUE_ADAPTER=nats-core
MEMORY_NATS_URL=nats://127.0.0.1:4222
MEMORY_MAX_REQUEST_BYTES=1048576
