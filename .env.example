APP_ENV=development
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=30s
DATABASE_URL=postgres://memory:memory@localhost:5432/memory?sslmode=disable
AUTH_SESSION_TTL=12h
AUTH_COOKIE_SECURE=false

# Only the two supported memory dimensions are configured in code:
# user-global and session.

# Local embedding and model providers are disabled until explicitly enabled.
EMBEDDING_ENABLED=false
EMBEDDING_ARTIFACT=models/all-MiniLM-L6-v2-Q8_0.gguf
MEMORY_LLM_ENABLED=false
MEMORY_LLM_BASE_URL=
MEMORY_LLM_MODEL=
MEMORY_LLM_API_KEY=
ALLOW_EXTERNAL_LLM_ANALYSIS=false
RERANKER_ENABLED=false
RERANKER_BASE_URL=
RERANKER_MODEL=
RERANKER_API_KEY=

# NATS Core is the default best-effort notification adapter. PostgreSQL remains
# the durable job source of truth. Set MQ_ADAPTER=none to use database polling.
MQ_ADAPTER=nats-core
MQ_URL=nats://127.0.0.1:4222
MAX_REQUEST_BYTES=1048576
